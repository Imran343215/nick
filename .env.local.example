# Copy this file to .env.local and adjust the values, then run: npm run seed
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_repair_shop

# Optional branding used across the site
APP_NAME=PhoneFix Pro

# ---- New-order notifications (optional) ----
# The shop admin gets an email + WhatsApp message each time a checkout is paid.
# Leave unset (or remove) to disable notifications — the site still works.

# Recipient for order notifications
ADMIN_EMAIL=you@example.com
ADMIN_WHATSAPP=+447000000000

# Email via SMTP (nodemailer). SMTP_HOST is required for email notifications.
SMTP_HOST=             # e.g. smtp.gmail.com or your provider's host
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=iTECHNICK <no-reply@example.com>

# WhatsApp via Twilio Messages API. All four are required for WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155255555   # a Twilio WhatsApp-enabled number