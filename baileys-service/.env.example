# Same MongoDB the main site uses (see the site's .env.local) — the bridge
# reads/writes the same chatmessages / chatlinks collections.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Your personal WhatsApp number (international format, digits only, no +),
# e.g. 447700900123. This is the account you'll link via QR code, and the
# number visitor messages get forwarded to.
OWNER_NUMBER=+918820768204

# Any long random string. Must match INTERNAL_API_SECRET in the site's
# .env.local — it's how app/api/chat/send authenticates to this service.
INTERNAL_API_SECRET=yyyy

# Port this service listens on.
PORT=3001
